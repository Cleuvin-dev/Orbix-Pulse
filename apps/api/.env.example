# Local dev (docker-compose em infrastructure/docker/docker-compose.yml)
DATABASE_URL="postgresql://orbix:orbix@localhost:5432/orbix_pulse_dev?schema=public"

PORT=3001
# Origem do apps/web para CORS — padrão já é http://localhost:3000, só setar se mudar a porta do front.
# WEB_ORIGIN="http://localhost:3000"

# Supabase Auth (Fase 2 — docs/12-roadmap-fases.md). Só autenticação nesta fase;
# o banco de dados de negócio continua no Postgres local acima.
# Pegue em Settings > API do projeto Supabase.
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
